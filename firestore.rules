rules_version = '2';
// Sri Durga Parameshwari Temple app — v1 rules (demo grade).
// No Firebase Auth yet: reads are public, writes are open but strictly validated.
// NEXT HARDENING STEP (before public launch): enable Firebase Auth, add admin
// custom claims, restrict content writes to admins and scope booking/donation
// reads to the owning user.
service cloud.firestore {
  match /databases/{database}/documents {
    function isString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isNum(v, min, max) {
      return v is number && v >= min && v <= max;
    }

    match /templeProfile/config {
      allow read: if true;
      allow write: if request.resource.data.name is map
        && isString(request.resource.data.name.en, 1, 120);
    }

    match /sevas/{id} {
      allow read: if true;
      allow write: if request.resource.data.name is map
        && isString(request.resource.data.name.en, 1, 120)
        && isNum(request.resource.data.price, 0, 1000000)
        && isNum(request.resource.data.durationMin, 5, 480)
        && isNum(request.resource.data.capacity, 1, 1000)
        && request.resource.data.active is bool;
    }

    match /events/{id} {
      allow read: if true;
      allow write: if request.resource.data.name is map
        && isString(request.resource.data.name.en, 1, 140)
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.text is map
        && isString(request.resource.data.text.en, 1, 500);
      allow delete: if true; // demo-grade; restrict to admins with Firebase Auth
    }

    match /admins/{phone} {
      // Admin users are created by the super user; phone is the unique id.
      // Demo-grade: PINs are stored as SHA-256 hashes, but reads are open so
      // Firebase Auth (with custom claims) must replace this before launch.
      allow read: if true;
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone == phone
        && request.resource.data.phone.matches('[0-9]{10}')
        && isString(request.resource.data.name, 1, 60)
        && request.resource.data.role in ['super', 'admin']
        && request.resource.data.active is bool
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.matches('[0-9a-f]{64}');
      allow update: if request.resource.data.phone == resource.data.phone
        && isString(request.resource.data.name, 1, 60)
        && request.resource.data.role in ['super', 'admin']
        && request.resource.data.active is bool
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.matches('[0-9a-f]{64}');
      allow delete: if false;
    }

    match /bookings/{id} {
      allow read: if true;
      allow create: if request.resource.data.bookingCode is string
        && request.resource.data.bookingCode.matches('SDP-[0-9]{8}-[0-9]{3}')
        && isString(request.resource.data.devoteeName, 1, 60)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('[0-9]{10,15}')
        && request.resource.data.sevaId is string
        && isString(request.resource.data.date, 8, 10)
        && request.resource.data.status in ['confirmed', 'cancelled', 'completed']
        && request.resource.data.paymentStatus in ['unpaid', 'paid'];
      // Only status / payment-status transitions allowed after creation.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'paidBy', 'paidAt', 'receiptNo'])
        && request.resource.data.status in ['confirmed', 'cancelled', 'completed']
        && request.resource.data.paymentStatus in ['unpaid', 'paid'];
      allow delete: if false;
    }

    match /donations/{id} {
      allow read: if true;
      allow create: if isNum(request.resource.data.amount, 1, 10000000)
        && isString(request.resource.data.purpose, 1, 60)
        && request.resource.data.receiptNo is string
        && request.resource.data.receiptNo.matches('SDP-D-[0-9]{4}-[0-9]{4}');
      allow update, delete: if false;
    }
  }
}
